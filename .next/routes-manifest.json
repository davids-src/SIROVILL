{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/szolgaltatasok/aramkor-bovites-elosztoszekreny",
      "destination": "/szolgaltatasok/villanyszereles-felujitas",
      "statusCode": 308,
      "regex": "^(?!/_next)/szolgaltatasok/aramkor-bovites-elosztoszekreny(?:/)?$"
    },
    {
      "source": "/szolgaltatasok/hibaelharitas",
      "destination": "/szolgaltatasok/villanyszerelesi-hibaelharitas",
      "statusCode": 308,
      "regex": "^(?!/_next)/szolgaltatasok/hibaelharitas(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/blog/[slug]",
      "regex": "^/blog/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/blog/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/szolgaltatasok/[slug]",
      "regex": "^/szolgaltatasok/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/szolgaltatasok/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/adatvedelem",
      "regex": "^/adatvedelem(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/adatvedelem(?:/)?$"
    },
    {
      "page": "/aszf",
      "regex": "^/aszf(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/aszf(?:/)?$"
    },
    {
      "page": "/blog",
      "regex": "^/blog(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/blog(?:/)?$"
    },
    {
      "page": "/kapcsolat",
      "regex": "^/kapcsolat(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/kapcsolat(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/rolunk",
      "regex": "^/rolunk(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/rolunk(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/szolgaltatasok",
      "regex": "^/szolgaltatasok(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/szolgaltatasok(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}